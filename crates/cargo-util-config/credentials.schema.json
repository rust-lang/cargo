{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credentials",
  "description": "Cargo's `credentials.toml` file",
  "type": "object",
  "properties": {
    "registry": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryCredential"
        },
        {
          "type": "null"
        }
      ]
    },
    "registries": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/RegistryCredential"
      }
    }
  },
  "$defs": {
    "RegistryCredential": {
      "description": "Credentials for a registry.",
      "type": "object",
      "properties": {
        "token": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}